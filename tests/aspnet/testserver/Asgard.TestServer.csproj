<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Asgard.TestServer</RootNamespace>
  </PropertyGroup>

  <!--
    The two Asgard packages this server actually needs:
      DPoP            -> .WithDPoP() and .UseTideSecuredDPoP()
      Authentication  -> Utils.GetEd25519IssuerKey()
    Tide.Asgard.Core and Ork.Clients come in transitively. Nothing else is
    referenced on purpose: no Ork.Models, no policy stack.
  -->
  <ItemGroup>
    <ProjectReference Include="../../../aspnet/Tide.Asgard.AspNetCore/Tide.Asgard.AspNetCore.DPoP/Tide.Asgard.AspNetCore.DPoP.csproj" />
    <ProjectReference Include="../../../aspnet/Tide.Asgard.AspNetCore/Tide.Asgard.AspNetCore/Tide.Asgard.AspNetCore.Authentication.csproj" />
  </ItemGroup>

</Project>
