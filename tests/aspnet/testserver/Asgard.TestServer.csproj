<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Asgard.TestServer</RootNamespace>
  </PropertyGroup>

  <!--
    The one Asgard package this server needs, for .AddAsgard().RequireTokenBinding()
    and .UseTide_over_DPoP(). Tide.Asgard.Core and Ork.Clients come in
    transitively. Nothing else is referenced on purpose: no Ork.Models, no
    policy stack.
  -->
  <ItemGroup>
    <ProjectReference Include="../../../aspnet/Tide.Asgard.AspNetCore/Tide.Asgard.AspNetCore/Tide.Asgard.AspNetCore.Authentication.csproj" />
  </ItemGroup>

</Project>
