<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Tide.Asgard.Scheduler</PackageId>
    <Version>0.1.0</Version>
    <Authors>Tide Foundation Limited</Authors>
    <Company>Tide Foundation Limited</Company>
    <Description>Durable task scheduling for the Tide Asgard SDK. Schedule expression parser and occurrence evaluator with no external dependencies.</Description>
    <PackageTags>tide;asgard;scheduler;cron;jobs</PackageTags>
    <PackageProjectUrl>https://github.com/tide-foundation/asgard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tide-foundation/asgard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
