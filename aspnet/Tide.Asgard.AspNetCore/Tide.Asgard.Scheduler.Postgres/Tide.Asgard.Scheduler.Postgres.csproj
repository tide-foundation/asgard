<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Tide.Asgard.Scheduler.Postgres</PackageId>
    <Version>0.1.0</Version>
    <Authors>Tide Foundation Limited</Authors>
    <Company>Tide Foundation Limited</Company>
    <Description>Postgres job store for the Tide Asgard scheduler. Supply a connection string and the SDK provides the schema, the claim and lease queries and the reaper.</Description>
    <PackageTags>tide;asgard;scheduler;postgres;jobs</PackageTags>
    <PackageProjectUrl>https://github.com/tide-foundation/asgard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tide-foundation/asgard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tide.Asgard.Scheduler\Tide.Asgard.Scheduler.csproj" />
  </ItemGroup>

</Project>
