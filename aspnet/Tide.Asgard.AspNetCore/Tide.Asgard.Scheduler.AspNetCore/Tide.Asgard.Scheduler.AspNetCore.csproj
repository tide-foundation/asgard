<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Tide.Asgard.Scheduler.AspNetCore</PackageId>
    <Version>0.1.0</Version>
    <Authors>Tide Foundation Limited</Authors>
    <Company>Tide Foundation Limited</Company>
    <Description>Dependency injection and hosted service wiring for the Tide Asgard scheduler. Registers jobs whose handlers resolve from a scope per run, and runs the worker for the lifetime of the host.</Description>
    <PackageTags>tide;asgard;scheduler;aspnetcore;hostedservice</PackageTags>
    <PackageProjectUrl>https://github.com/tide-foundation/asgard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tide-foundation/asgard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tide.Asgard.Scheduler\Tide.Asgard.Scheduler.csproj" />
  </ItemGroup>

</Project>
